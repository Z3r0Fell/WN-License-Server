# WatchNexus frontend image - builds React (with REACT_APP_* baked in),
# serves with nginx (inner) which also reverse-proxies /api to the backend.
FROM node:20-alpine AS build
WORKDIR /app

# Copy the whole frontend in one shot. We deliberately avoid wildcard COPYs
# (e.g. `COPY frontend/yarn.lock* ./`) because BuildKit's handling of
# zero-match wildcards is unreliable across versions and has been the cause
# of every "failed to compute cache key" error we've hit during deploy.
COPY frontend/ ./

# If yarn.lock was committed, use --frozen-lockfile for reproducible builds.
# If not (common when the repo was pushed without a lockfile), do a fresh
# install which will generate yarn.lock inside the image.
RUN if [ -f yarn.lock ]; then \
        echo ">> yarn.lock present - frozen install"; \
        yarn install --frozen-lockfile --network-timeout 600000; \
    else \
        echo ">> yarn.lock missing - regenerating (slower; commit yarn.lock for faster builds)"; \
        yarn install --network-timeout 600000; \
    fi

# Build-time env baked into the bundle.
ARG REACT_APP_BACKEND_URL=""
ARG REACT_APP_CUSTOMER_PORTAL_HOST=""
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
ENV REACT_APP_CUSTOMER_PORTAL_HOST=$REACT_APP_CUSTOMER_PORTAL_HOST
RUN yarn build

# ---- Runtime image ----------------------------------------------------------
FROM nginx:1.27-alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY deploy/nginx/site.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
