# WatchNexus frontend image - builds React, serves with nginx (also reverse-proxies /api to backend)
FROM node:20-alpine AS build
WORKDIR /app

COPY frontend/package.json frontend/yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 600000

COPY frontend/ ./
# REACT_APP_BACKEND_URL is baked into the build at build time. The default is
# empty ("") so axios will use a same-origin URL like "/api" - perfect when
# nginx serves both the static site and proxies /api to the backend.
ARG REACT_APP_BACKEND_URL=""
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
RUN yarn build

FROM nginx:1.27-alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY deploy/nginx/site.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
