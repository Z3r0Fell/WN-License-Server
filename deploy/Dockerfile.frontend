# WatchNexus frontend image - builds React (with REACT_APP_* baked in),
# serves with nginx (inner) which also reverse-proxies /api to the backend.
FROM node:20-alpine AS build
WORKDIR /app

# yarn.lock is optional - the trailing * + the shell `if` below let us build
# even when the repo was pushed without a lockfile. With a lockfile we use
# --frozen-lockfile for reproducible builds; without one, we install fresh
# (slower, but functional).
COPY frontend/package.json ./
COPY frontend/yarn.lock* ./

RUN if [ -f yarn.lock ]; then \
        echo "Using yarn.lock - frozen install"; \
        yarn install --frozen-lockfile --network-timeout 600000; \
    else \
        echo "No yarn.lock found - regenerating (this is slower; commit yarn.lock for faster builds)"; \
        yarn install --network-timeout 600000; \
    fi

COPY frontend/ ./

# Build-time env baked into the bundle
ARG REACT_APP_BACKEND_URL=""
ARG REACT_APP_CUSTOMER_PORTAL_HOST=""
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
ENV REACT_APP_CUSTOMER_PORTAL_HOST=$REACT_APP_CUSTOMER_PORTAL_HOST
RUN yarn build

FROM nginx:1.27-alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY deploy/nginx/site.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
