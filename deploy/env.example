# WatchNexus deployment env. Copy to `.env` and fill in real values.
# Keep this file out of git.

# ---- Required ----
DOMAIN=licenses.watchnexus.ca
CUSTOMER_DOMAIN=techhub.watchnexus.ca
LETSENCRYPT_EMAIL=you@watchnexus.ca

# Database
DB_NAME=watchnexus

# CORS - if frontend and backend share a domain (default), "*" is fine.
# Otherwise list explicit origins comma-separated.
CORS_ORIGINS=*

# ---- Crypto / auth secrets - GENERATE NEW VALUES ON FIRST DEPLOY ----
# Easy generation:  openssl rand -hex 32
JWT_SECRET=change-me-to-32-byte-random-hex
HMAC_LICENSE_SECRET=change-me-to-32-byte-random-hex

# ---- Seeded admin (auto-created on first boot) ----
SEED_ADMIN_EMAIL=admin@watchnexus.ca
SEED_ADMIN_PASSWORD=change-this-please

# ---- Public URLs (used in emails + portal links) ----
APP_PUBLIC_URL=https://licenses.watchnexus.ca
CUSTOMER_PORTAL_URL=https://techhub.watchnexus.ca

# ---- Frontend build args ----
# These are baked into the React build via webpack DefinePlugin (CRA).
# Empty REACT_APP_BACKEND_URL means "same origin" so axios uses /api locally.
REACT_APP_BACKEND_URL=
REACT_APP_CUSTOMER_PORTAL_HOST=techhub.watchnexus.ca

# ---- Webhook secrets - ALSO editable from /admin/settings ----
# The website owns checkout; this is only needed if you use Stripe webhooks
# to trigger serial issuance automatically.
STRIPE_WEBHOOK_SECRET=

# ---- Email delivery (set ONE of: SendGrid HTTP OR SMTP) ----
# Also editable from /admin/settings - DB values take precedence over these.
EMAIL_FROM=licenses@watchnexus.ca
EMAIL_FROM_NAME=WatchNexus
EMAIL_FROM_BRAND=WatchNexus

# Option A: SendGrid HTTP API
SENDGRID_API_KEY=

# Option B: SMTP (e.g. Postmark, Mailgun, SES, Gmail-with-App-Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ---- RSA license signing keys (generated automatically inside the container if missing) ----
RSA_PRIVATE_KEY_PATH=/app/keys/license_rsa_private.pem
RSA_PUBLIC_KEY_PATH=/app/keys/license_rsa_public.pem
