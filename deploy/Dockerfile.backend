# WatchNexus backend image
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps for cryptography + tar (for backups).
# NOTE: We intentionally do NOT install `mongodb-database-tools` here. The
# MongoDB apt repo for Debian bookworm has been flaky during deploys (apt
# exit 100). The backup script falls back to a pure-Python JSON export when
# `mongodump` is unavailable, which is good enough for restore via
# `mongorestore --drop` from the `mongo` container OR `mongoimport`.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential libssl-dev curl ca-certificates tar \
  && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./requirements.txt
RUN pip install -r requirements.txt

COPY backend/ ./

EXPOSE 8001

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "2"]
